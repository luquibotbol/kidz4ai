{
  "name": "workshop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview -c wrangler.private.jsonc",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -c wrangler.private.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "e2e": "./test/e2e.sh"
  },
  "dependencies": {
    "next": "^15.5.22",
    "openai": "^7.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wrangler": "^4.124.0"
  }
}
